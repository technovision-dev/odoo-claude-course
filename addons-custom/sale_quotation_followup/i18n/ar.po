#. module: sale_quotation_followup
#: model:mail.template,body_html:sale_quotation_followup.mail_template_followup_friendly
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>A few days ago we sent you quotation <strong t-out=\"object.name or ''\">S00001</strong>\n"
"    for <t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 100.00</t>.\n"
"    Do you have any questions, or would you like us to change anything?</p>\n"
"    <p>You can review and accept it online:\n"
"    <a t-att-href=\"object.get_portal_url()\">view the quotation</a>.</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\">Sales</t></p>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n    <p>مرحبًا <t t-out=\"object.partner_id.name or ''\">Customer</t>،</p>\n    <p>أرسلنا إليك منذ أيام عرض السعر <strong t-out=\"object.name or ''\">S00001</strong>\n    بقيمة <t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 100.00</t>.\n    هل لديك أي أسئلة، أو تريد أن نغيّر شيئًا فيه؟</p>\n    <p>يمكنك مراجعته وقبوله عبر الإنترنت:\n    <a t-att-href=\"object.get_portal_url()\">عرض عرض السعر</a>.</p>\n    <p>مع أطيب التحيات،<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\">Sales</t></p>\n</div>\n            "

#. module: sale_quotation_followup
#: model:mail.template,body_html:sale_quotation_followup.mail_template_followup_final
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>We have not heard back about quotation <strong t-out=\"object.name or ''\">S00001</strong>.\n"
"    <t t-if=\"object.validity_date\">It is valid until <t t-out=\"format_date(object.validity_date) or ''\">01/01/2026</t>.</t>\n"
"    If your plans have changed, just reply to this email and we will close it.</p>\n"
"    <p><a t-att-href=\"object.get_portal_url()\">View the quotation</a></p>\n"
"    <p>Best regards,<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\">Sales</t></p>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n    <p>مرحبًا <t t-out=\"object.partner_id.name or ''\">Customer</t>،</p>\n    <p>لم يصلنا رد بخصوص عرض السعر <strong t-out=\"object.name or ''\">S00001</strong>.\n    <t t-if=\"object.validity_date\">وهو صالح حتى <t t-out=\"format_date(object.validity_date) or ''\">01/01/2026</t>.</t>\n    إن تغيّرت خططك، يكفي أن ترد على هذه الرسالة وسنغلقه.</p>\n    <p><a t-att-href=\"object.get_portal_url()\">عرض عرض السعر</a></p>\n    <p>مع أطيب التحيات،<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\">Sales</t></p>\n</div>\n            "


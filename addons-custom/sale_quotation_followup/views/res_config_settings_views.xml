<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_quotation_followup" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.quotation.followup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="inside">
                <setting id="quotation_followup" company_dependent="1"
                         help="Email customers automatically about quotations they have not answered.">
                    <field name="quotation_followup_enabled"/>
                    <div class="content-group" invisible="not quotation_followup_enabled">
                        <div class="mt8">
                            <field name="quotation_followup_skip_expired" class="oe_inline"/>
                            <label for="quotation_followup_skip_expired" class="o_light_label"/>
                        </div>
                        <div class="mt8">
                            <button name="%(quotation_followup_level_action)d" icon="oi-arrow-right"
                                    type="action" string="Follow-up Levels" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>

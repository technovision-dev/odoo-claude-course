<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quotation_followup_log_view_list" model="ir.ui.view">
        <field name="name">quotation.followup.log.list</field>
        <field name="model">quotation.followup.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="result == 'failed'">
                <field name="date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="level_id"/>
                <field name="result"/>
                <field name="note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="quotation_followup_log_view_form" model="ir.ui.view">
        <field name="name">quotation.followup.log.form</field>
        <field name="model">quotation.followup.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="level_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="result"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="quotation_followup_log_view_search" model="ir.ui.view">
        <field name="name">quotation.followup.log.search</field>
        <field name="model">quotation.followup.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="level_id"/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                <filter name="group_level" string="Level" context="{'group_by': 'level_id'}"/>
            </search>
        </field>
    </record>

    <record id="quotation_followup_log_action" model="ir.actions.act_window">
        <field name="name">Quotation Follow-ups</field>
        <field name="res_model">quotation.followup.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
